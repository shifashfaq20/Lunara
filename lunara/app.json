{
  "expo": {
    "name": "LUNARA",
    "slug": "lunara",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lunara",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#050811",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lunara.missiontrainer"
    },
    "android": {
      "package": "com.lunara.missiontrainer",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#050811"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#050811"
        }
      ],
      "expo-status-bar",
      "expo-image"
    ]
  }
}
