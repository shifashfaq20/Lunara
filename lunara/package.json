{
  "name": "lunara",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "setup": "expo install react react-native expo-router expo-linking expo-constants expo-status-bar expo-system-ui expo-splash-screen expo-image react-native-reanimated react-native-worklets react-native-svg react-native-safe-area-context react-native-screens @react-native-async-storage/async-storage lucide-react-native nativewind@^4.2.7 tailwindcss@^3.4.17",
    "setup:dev": "expo install typescript @types/react jest-expo jest @types/jest -- --save-dev",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "doctor": "npx expo-doctor@latest"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.0",
    "expo-constants": "~58.0.15",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "lucide-react-native": "^1.70.0",
    "nativewind": "^4.2.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0",
    "tailwindcss": "^3.4.17"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  },
  "devDependencies": {
    "typescript": "~6.0.3"
  }
}
